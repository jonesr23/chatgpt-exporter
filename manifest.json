// Manifest for chrome extension
{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Exporter",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "downloads", "webRequest", "storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {
    "default_title": "Export current chat"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
        "matches":["*://chatgpt.com/*"],
        "js": ["jszip.min.js", "extract.js"],
        "run_at": "document_idle"
    }
  ]
}
